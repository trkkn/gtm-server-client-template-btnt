// TODO: make list of search engine referrers configurable

const claimRequest = require("claimRequest");
const computeEffectiveTldPlusOne = require("computeEffectiveTldPlusOne");
const decodeUriComponent = require("decodeUriComponent");
const encodeUriComponent = require("encodeUriComponent");
const getRequestPath = require("getRequestPath");
const getTimestampMillis = require("getTimestampMillis");
const getRequestBody = require("getRequestBody");
const getRequestQueryString = require("getRequestQueryString");
const getType = require("getType");
const getContainerVersion = require("getContainerVersion");
const getCookieValues = require("getCookieValues");
const getRequestHeader = require("getRequestHeader");
const getRequestMethod = require("getRequestMethod");
const JSON = require("JSON");
const logToConsole = require("logToConsole");
const makeInteger = require("makeInteger"); // returns Number or null
const makeNumber = require("makeNumber"); // returns Number or null
const parseUrl = require("parseUrl");
const runContainer = require("runContainer");
const setCookie = require("setCookie");
const setPixelResponse = require("setPixelResponse");
const setResponseHeader = require("setResponseHeader");
const setResponseStatus = require("setResponseStatus");
const setResponseBody = require("setResponseBody");
const returnResponse = require("returnResponse");

const START_TIME = getTimestampMillis();

let serverTimings = "";

const REQUIRED_PARAMETERS = ["event_name", "page_location"];

// run the main logic in a fuction
// so that eslint doesnt complain :-)
execute();

function execute() {
  const COLLECT_PATH = "/btnt";

  const reqPath = getRequestPath();

  if (reqPath.indexOf(COLLECT_PATH) !== 0) {
    return;
  }

  if (!isValidOrigin() || isWeirdGTMScannerPage()) {
    // return prematurely and do not
    // claim this request
    return;
  }

  if (inDebugMode()) {
    // we can use server-timings header to understand better
    // which tasks took how long on the server
    serverTimings = addToServerTiming(serverTimings, "validation-of-request", START_TIME);
  }

  if (reqPath === COLLECT_PATH + ".js") {
    claimRequest();
    serveLibrary();
    return;
  }

  if (reqPath === COLLECT_PATH && getRequestMethod() === "OPTIONS") {
    claimRequest();
    closeClientConnection();
    return;
  }

  claimRequest();
  const rawEventInput = getEventInput();

  if (!rawEventInput) {
    returnResponse();
    return;
  }

  let isFinalEvent = false;

  for (let i = 0; i < rawEventInput.length; i += 1) {
    isFinalEvent = rawEventInput.length === i + 1;
    const eventInputString = rawEventInput[i];

    const eventData = getEventData(eventInputString);

    runEvent(eventData, isFinalEvent);
  }

  // if we are in production mode, we dont want
  // to wait for the container to finish before
  // returning the reponse in order to not
  // have the client wait unnessecarily
  if (!data.waitForTags) {
    closeClientConnection(serverTimings, rawEventInput);
  }
}

// ---- helper functions
/**
 * @returns Array of queryStrings which contain events, e.g. ["event_name=page_view&client_id=123", "event_name=click&client_id=456"]
 */
function getEventInput() {
  let eventInput = null;

  if (getRequestQueryString() && getRequestMethod() === "GET") {
    // always return an array so that we dont have to do a distiction between string and array anywhere else
    eventInput = [getRequestQueryString()];
  }

  const parsedRequestBody = JSON.parse(getRequestBody());
  if (
    parsedRequestBody &&
    parsedRequestBody.length &&
    parsedRequestBody.length > 0 &&
    getRequestMethod() === "POST"
  ) {
    eventInput = parsedRequestBody;
  }
  log("getEventInput returning with: " + eventInput);
  return eventInput;
}

function runEvent(eventInput, isFinalEvent) {
  const eventData = eventInput;
  // ------ create new session
  // no new session in event data to distinguish between actual no new session or calculate sessions = false setting.
  if (data.generateSessionEvent) {
    eventData.new_session = isNewSession(eventData);
    log("test-isNewSession-" + eventData.new_session);
    logToConsole("test-isNewSession-" + eventData.new_session);
  }

  // ------ create new user
  if (data.generateNewUserEvent) {
    eventData.new_user = determineNewUserStatus();
    log("test-isNewUser-" + eventData.new_user);
    logToConsole("test-isNewUser-" + eventData.new_user);
  }

  //  ------ create attribution
  eventData.traffic_source = getAttribution(eventData, eventData.new_session, "SOURCE");
  logToConsole("test-isSource-" + eventData.traffic_source);
  eventData.traffic_medium = getAttribution(eventData, eventData.new_session, "MEDIUM");
  logToConsole("test-isMedium-" + eventData.traffic_medium);

  if (isFinalEvent && data.addCrossRequestAttributionData) {
    storeAttribution(eventData.traffic_source, "SOURCE");

    storeAttribution(eventData.traffic_medium, "MEDIUM");
  }

  if (isFinalEvent && inDebugMode()) {
    serverTimings = addToServerTiming(serverTimings, "creation-of-event-data", START_TIME);
  }

  runContainer(eventData, () => {
    if (isFinalEvent && inDebugMode()) {
      serverTimings = addToServerTiming(serverTimings, "running-event", START_TIME);
    }

    log("done processing request");
    if (isFinalEvent && data.waitForTags) {
      closeClientConnection(serverTimings, eventData);
    }
  });
}

function closeClientConnection(timingHeader, eventData) {
  const origin =
    getRequestHeader("origin") || (!!getRequestHeader("referer") && getRequestHeader("referer"));
  if (origin) {
    setResponseHeader("Access-Control-Allow-Origin", origin);
    setResponseHeader("Access-Control-Allow-Credentials", "true");
    setResponseHeader("Access-Control-Allow-Methods", "POST, GET, OPTIONS");
    setResponseHeader("Access-Control-Allow-Headers", "content-type,keepalive");
  }
  if (inDebugMode() && timingHeader) {
    setResponseHeader("Server-Timing", timingHeader);
  }

  if (data.returnEventData) {
    setResponseHeader("Content-Type", "application/json");
    setResponseBody(JSON.stringify(eventData));
  } else {
    setPixelResponse();
  }
  returnResponse();
  log("conectionClosed");
}

function log(msg) {
  logToConsole("BTNT - " + msg);
}

/**
 *
 * @param {string} eventInput query string containing event data
 * @returns {Object} eventData object with all required parameters and custom parameters
 */
function getEventData(eventInputString) {
  let eventData = queryStringTOObject(eventInputString);
  for (let i = 0; i < REQUIRED_PARAMETERS.length; i += 1) {
    if (!eventData[REQUIRED_PARAMETERS[i]]) {
      log("missing required parameter: " + REQUIRED_PARAMETERS[i]);
      setResponseStatus(400);
      setResponseBody("missing: " + REQUIRED_PARAMETERS[i]);
      return false;
    }
  }
  eventData = getDecodedObjectValues(eventData);

  eventData.page_host = parseUrl(eventData.page_location)
    ? parseUrl(eventData.page_location).host
    : false;

  const pageLocationQueryParamObject = getQueryParamObjectFromURLString(eventData.page_location);

  if (pageLocationQueryParamObject) {
    eventData.pageLocationQueryParamObject = pageLocationQueryParamObject;
  }

  eventData.custom_parameters = getCustomParamObject(eventData);

  const isMetric = true;
  eventData.custom_metrics = getCustomParamObject(eventData, isMetric);
  eventData = removeCustomParametersFromEventData(eventData);

  let piiSafeEvent = eventData;
  if (data.removePii) {
    piiSafeEvent = makePiiSafeObject(eventData);
  }

  log("piiSafeEvent: " + JSON.stringify(piiSafeEvent));
  return eventData;
}

function getDecodedObjectValues(obj) {
  const decodedObject = obj;
  for (const key in obj) {
    if (obj[key] && getType(obj[key]) === "string") {
      // decode the value until there are no more encoded characters
      while (decodedObject[key] !== decodeUriComponent(decodedObject[key])) {
        decodedObject[key] = decodeUriComponent(decodedObject[key]);
      }
    }
  }
  return decodedObject;
}

function getCustomParamObject(eventData, isMetric) {
  const serverEventParams = getCustomServerEventData(isMetric);
  const clientEventParams = getCustomClientEventData(eventData, isMetric);
  const customParamsObject = serverEventParams.concat(clientEventParams);
  return customParamsObject;
}

/**
 * @param {Boolean} isMetric indicates if the prefix is for metrics or not
 * @returns Array of objects with key-value pairs of custom parameters, e. g. [{foo: "bar", "ep.foo": "bar"}]
 */
function getCustomServerEventData(isMetric) {
  let customDataToAdd = data.customEventParameters;
  if (isMetric) {
    customDataToAdd = data.customEventMetrics;
  }

  const customData = [];
  if (customDataToAdd && customDataToAdd.length && customDataToAdd.length > 0) {
    for (let i = 0; i < customDataToAdd.length; i += 1) {
      const customParam = customDataToAdd[i];

      // avoid pushing params that have no values
      if (customParam.paramName && customParam.paramValue) {
        customData.push({ name: customParam.paramName, value: customParam.paramValue });
      }
    }
  }
  return customData;
}

/**
 * @param {Object} eventData eventData as retrieved from the request
 * @param {Boolean} isMetricPrefix indicates if the prefix is for metrics or not
 * @returns Object with key-value pairs of custom parameters, e. g. [{foo: "bar"}]
 */
function getCustomClientEventData(eventData, isMetric) {
  let customData = [];
  const eventParamPrefix = getPrefixOFCustomParams(eventData, isMetric);
  if (eventParamPrefix && eventData) {
    customData = getLegacyCustomEventData(eventData, eventParamPrefix, isMetric);
  } else if (eventData) {
    customData = removeDefaultParametersFromEventData(eventData, isMetric);
  }
  return customData;
}

/**
 * @param {Object} eventData eventData as retrieved from the request
 * @param {Boolean} isMetricPrefix indicates if the prefix is for metrics or not
 * @returns undefined, or the first prefix of the first key in the eventData object which has a data type according to the isMetricPrefix parameter
 */
function getPrefixOFCustomParams(eventData, isMetricPrefix) {
  let customParamPrefix;
  if (eventData) {
    for (const key in eventData) {
      // if the prefix is for metrics, only look at the keys that are set for numeric values
      // if the prefix is NOT for metrics, only look at the keys that are set for non-numeric values
      if (actualAndExpectedDataTypeMatch(eventData[key], isMetricPrefix)) {
        customParamPrefix = getPrefixFromParamName(key);
        if (customParamPrefix) {
          break;
        }
      }
    }
  }
  return customParamPrefix;
}

function actualAndExpectedDataTypeMatch(val, isMetric) {
  // if the prefix is for metrics, only look at the keys that are set for numeric values
  // if the prefix is NOT for metrics, only look at the keys that are set for non-numeric values
  let match = false;
  if ((isMetric && isNumeric(val)) || (!isMetric && !isNumeric(val))) {
    match = true;
  }
  return match;
}

function isNumeric(value) {
  return !!makeNumber(value);
}

/**
 * @param {string} paramName name of parameter, e. g. "ep.custom_parameter"
 * @returns e. g. "ep." or null if paramName is not valid
 */
function getPrefixFromParamName(paramName) {
  if (paramName && paramName.split(".").length === 2) {
    return paramName.split(".")[0] + ".";
  }
  return "";
}

function removeCustomParametersFromEventData(eventData) {
  const defaultParameters = getDefaultParameters();
  const customData = {};
  for (const key in eventData) {
    if (defaultParameters.indexOf(key) >= 0) {
      customData[key] = eventData[key];
    }
  }
  return customData;
}

/**
 * @param {Object} eventData object with key-value pairs build from the URL from the incoming request
 * @param {Boolean} isMetric indicates if the prefix is for metrics or not
 * @returns Array of objects with name and value properties, e. g. [{name: "foo", value: "bar"}]
 */
function removeDefaultParametersFromEventData(eventData, isMetric) {
  const allDefaultParameters = getDefaultParameters();

  const customData = [];
  for (const key in eventData) {
    if (
      allDefaultParameters.indexOf(key) < 0 &&
      actualAndExpectedDataTypeMatch(eventData[key], isMetric)
    ) {
      if (eventData[key] && checkIFParameterINAllowList(key)) {
        customData.push({ name: key, value: eventData[key] });
      }
    }
  }
  return customData;
}

function getDefaultParameters() {
  const DEFAULT_PARAMETERS = [
    "client_id",
    "event_name",
    "event_timestamp",
    "page_referrer",
    "page_location",
    "page_title",
    "page_host",
    "new_user",
    "new_session",
    "traffic_source",
    "traffic_medium",
    "pageLocationQueryParamObject",
    "custom_parameters",
    "custom_metrics",
    "z",
  ];

  const additionalDefaultParameters = simpleTableTOArray(
    data.additionalDefaultParameters,
    "paramName"
  );

  const allDefaultParameters = DEFAULT_PARAMETERS.concat(additionalDefaultParameters);
  return allDefaultParameters;
}

/**
 *
 * @param {string} paramName name of the custom parameter
 * @returns Boolean
 */
function checkIFParameterINAllowList(paramName) {
  let paramISAllowed = false;
  if (!data.useCustomParameterAllowList) {
    paramISAllowed = true;
  } else if (data.customParameterAllowList && data.customParameterAllowList.length > 0) {
    const allowList = simpleTableTOArray(data.customParameterAllowList, "paramName");
    if (allowList.indexOf(paramName) >= 0) {
      paramISAllowed = true;
    }
  }
  return paramISAllowed;
}

/**
 * simpleTables created an array of objects like so: [{paramName: "foo"}, {paramName: "bar"}].
 * This function turns that into a simple array like so: ["foo", "bar"]
 *
 * @param {Array} table object created by the simpleTable field type in a sandboxed GTM asset
 * @param {String} columnName name of the column in the table
 * @returns Array of values from the column
 */
function simpleTableTOArray(table, columnName) {
  const array = [];
  if (table && table.length && table.length > 0) {
    for (let i = 0; i < table.length; i += 1) {
      const row = table[i];
      if (row[columnName]) {
        array.push(row[columnName]);
      }
    }
  }
  return array;
}

/**
 * kept around to support previous versions of BTNT
 * @param {Object} eventData object with key-value pairs build from the URL from the incoming request
 * @param {string} eventParamPrefix prefix for the custom event data, e. g. "ep."
 * @param {Boolean} isMetric indicates if the prefix is for metrics or not
 * @returns Array of objects with name and value properties, e. g. [{name: "foo", value: "bar"}]
 */
function getLegacyCustomEventData(eventData, eventParamPrefix, isMetric) {
  const customData = [];
  if (!eventParamPrefix) {
    return customData;
  }

  for (const key in eventData) {
    if (key.indexOf(eventParamPrefix) >= 0) {
      if (eventData[key] && actualAndExpectedDataTypeMatch(eventData[key], isMetric)) {
        const keyWithPrefix = key.split(eventParamPrefix)[1];
        customData.push({ name: keyWithPrefix, value: eventData[key] });
      }
    }
  }
  return customData;
}

function isNewSession(eventData) {
  log("evaluating if new session");
  const eventName = eventData.event_name;

  const fullpageReferrer = eventData.page_referrer;
  let pageReferrer;
  // check if the fullpageReferrer is an actual URL
  // since computeEffectiveTldPlusOne fails if not provided
  // a valid URL
  if (fullpageReferrer && fullpageReferrer.indexOf("http") === 0) {
    pageReferrer = computeEffectiveTldPlusOne(fullpageReferrer);
  }

  if (
    eventName !== data.sessionEventTriggerName &&
    data.sessionEventTriggerName.split("|").indexOf(eventName) < 0 &&
    data.sessionEventTriggerName !== "*"
  ) {
    log(
      "event '" +
        eventName +
        "' not eligible for new session. Eligible would be: " +
        data.sessionEventTriggerName
    );
    return false;
  }

  if (isExcludedReferrer(pageReferrer)) {
    log("referrer '" + pageReferrer + "' not eligible for new session");
    return false;
  }

  if (!eventData.page_host) {
    log("no new session because missing pageHost");
    return false;
  }

  // if the documentLocation contains the documentReferrer,
  // it means the user has clicked on a link on our website
  // which in turn means that this hit is not the start of a new session.
  let startNewSession = false;
  if (!pageReferrer || eventData.page_host.indexOf(pageReferrer) === -1) {
    startNewSession = true;
  }

  log(eventData.page_host + " and " + pageReferrer + " are different: " + startNewSession);
  log("starting a session: " + startNewSession);
  return startNewSession;
}

function isExcludedReferrer(referrer) {
  if (data.excludedReferrers === "*") return false;
  if (data.excludedReferrers && getType(data.excludedReferrers) === "string") {
    const regex = data.excludedReferrers.replace(".", "\\.");
    const isExcluded = referrer.match(regex);
    return isExcluded;
  }
  return false;
}

function determineNewUserStatus() {
  const USER_COOKIE_NAME = "BTNT_I_WAS_HERE";
  let isNewUser = false;
  const userHasBeenHere = getCookieValues(USER_COOKIE_NAME)[0];
  log("userHasBeenHere cookie value: " + userHasBeenHere);
  if (!userHasBeenHere) {
    isNewUser = true;
  }

  log("hit is from a new user: " + isNewUser);
  setUserCookie(USER_COOKIE_NAME);

  return isNewUser;
}

function setUserCookie(userCookieName) {
  // set a user cookie so that
  // the next time this user comes around
  // we do not create a newUserEvent again
  const TWO_YEARS_IN_SECONDS = 60 * 60 * 24 * 365 * 2;
  setCookie(userCookieName, "or was I?", {
    "max-age": TWO_YEARS_IN_SECONDS,
    httpOnly: true,
    domain: "auto",
  });
}

function makePiiSafeObject(eventData) {
  // first, we check if there is any PII in the request at all
  // if there's not we just return the original request
  // if there is PII, we go through the request in detail
  // and remove only the PII from it
  const hasPii = JSON.stringify(eventData).match(getPiiRegex());
  log("Has PII: " + hasPii);
  if (!hasPii) {
    return eventData;
  }

  const piiSafeData = eventData;
  for (const eventKey in piiSafeData) {
    if (piiSafeData[eventKey]) {
      let eventValue = piiSafeData[eventKey];
      if (getType(eventValue) === "string") {
        eventValue = getPiiSafeValue(eventValue);
      }

      // for example custom dimensions are passed as an object
      // inside of the main piiSafeData. In case our eventValue
      // is such an object, we need to approach pii-cleaning recursively
      else if (getType(eventValue) === "object") {
        eventValue = makePiiSafeObject(eventValue);
      }
      piiSafeData[eventKey] = eventValue;
    }
  }
  return piiSafeData;
}

/**
 * @param {string} eventValue - The input event value to be checked for PII.
 * @return {string} The modified string with any PII replaced with safe values.
 */
function getPiiSafeValue(eventValue) {
  let piiSaveValue = eventValue;
  const PII_REGEX = getPiiRegex();
  const MAX_ITERATIONS = 5;
  let currentIteration = 1;

  let found = piiSaveValue.match(PII_REGEX);
  while (found && currentIteration <= MAX_ITERATIONS) {
    log("found: " + found);
    const parts = piiSaveValue.split(found[0]);
    const replaceValue = getReplaceValue("PII", found[0]);
    piiSaveValue = parts.join(replaceValue);
    found = piiSaveValue.match(PII_REGEX);
    currentIteration += 1;
  }
  return piiSaveValue;
}

function getReplaceValue(piiName, found) {
  const keyValueRegex = "(=|%3D)";
  const keyValueSeparator = found.match(keyValueRegex);
  if (keyValueSeparator) {
    return encodeUriComponent(piiName + keyValueSeparator[0] + "[ redacted ]");
  }
  return encodeUriComponent("[ redacted " + piiName + " ]");
}

function getPiiRegex() {
  // negative lookahead regex that will stop matching at any
  // of the character-sequences in the innermost bracket
  const END_OF_VALUE_REGEX = "(?:(?!(=|%3D|&|%26)).)+";

  // this object exists for easier management of the regexes for PIIs
  // it not directly used by this client
  const piiRegex = [
    {
      name: "name",
      regex: "(first|last|vor|nach|user)[-_]?name(=|%3D)" + END_OF_VALUE_REGEX,
    },
    {
      name: "user",
      regex: "(user)[-_]?(=|%3D)" + END_OF_VALUE_REGEX,
    },
    {
      name: "password",
      regex: "password(=|%3D)" + END_OF_VALUE_REGEX,
    },
    {
      name: "passwort",
      regex: "passwort(=|%3D)" + END_OF_VALUE_REGEX,
    },
    {
      name: "address",
      regex: "(street|strasse|plz)(=|%3D)" + END_OF_VALUE_REGEX,
    },
    {
      name: "click-ID",
      regex: "(gclid|dclid|fbclid|msclkid)(=|%3D)" + END_OF_VALUE_REGEX,
    },
    {
      name: "email",
      regex: ".{0,4}(%40|@).{5}",
    },
  ];
  const piiRegexFull = piiRegex.map((e) => e.regex).join("|");
  return piiRegexFull;
}

function isValidOrigin() {
  let originValidity = false;
  // a * whitelists all origins
  if (data.allowedOrigins === "*") {
    originValidity = true;
  } else {
    const origin =
      (!!getRequestHeader("origin") && parseUrl(getRequestHeader("origin")).hostname) ||
      (!!getRequestHeader("referer") && parseUrl(getRequestHeader("referer")).host);
    log("request came from: " + origin);
    originValidity = data.allowedOrigins.split(",").indexOf(origin) > -1;
  }

  log("Request originated from valid origin: " + originValidity);
  return originValidity;
}

/**
 * there is an unknown scanner out there that
 * scans all GTMs in the world and triggers random events in them
 * creating bot-traffic. We dont want their data
 *
 * @returns Boolean
 */
function isWeirdGTMScannerPage() {
  const requestQuery = getRequestQueryString();
  const weirdGTMScannerPage = "gtm-msr.appspot.com";
  const isWeirdScanner = requestQuery.indexOf(weirdGTMScannerPage) >= 0;
  log("request is from GTM scanner bot: " + isWeirdScanner);

  return isWeirdScanner;
}

function isBotRequest() {
  // if the feature is not active,
  // dont check for bot-ness
  log("checking for bots: " + data.removeBots);
  if (!data.removeBots) return false;

  const userAgent = getRequestHeader("user-agent");
  // the regex is a the concatenated array of patterns
