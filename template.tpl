function inDebugMode() {
  const debugCookie = getCookieValues("BTNT_DEBUG")[0];
  if (!getContainerVersion().debugMode && !debugCookie) {
    return false;
  }
  return true;
}

function getQueryParamObjectFromURLString(urlString) {
  if (!urlString || getType(urlString) !== "string") return false;

  // urlString = https://example.com?utm_source=moin&utm_medium=test&something=else
  const urlParts = urlString.split("?");
  if (urlParts.length < 2) return {};

  // queryString = utm_source=moin&utm_medium=test&something=else
  const queryString = urlParts[1];

  const queryParamObject = queryStringTOObject(queryString);

  return queryParamObject;
}

function queryStringTOObject(queryString) {
  const queryParameters = queryString.split("&");
  const queryParamObject = {};
  for (let i = 0; i < queryParameters.length; i += 1) {
    // query = utm_source=moin
    const query = queryParameters[i];
    const queryParts = query.split("=");

    queryParamObject[queryParts[0]] = queryParts[1];
  }
  return queryParamObject;
}

function getAttribution(eventData, startNewSession, attributionKey) {
  log("get attribution called:" + startNewSession + " - " + attributionKey);
  let attributionValue;

  if (startNewSession && attributionKey === "SOURCE") {
    attributionValue = calculateNewSource(eventData, startNewSession);
  }

  if (startNewSession && attributionKey === "MEDIUM") {
    attributionValue = calculateNewMedium(eventData, startNewSession);
  }

  if (!attributionValue) {
    attributionValue = getAttributionCookie(attributionKey);
  }

  return attributionValue;
}

function calculateNewSource(eventData) {
  let source;

  if (eventData.pageLocationQueryParamObject.utm_source) {
    source = eventData.pageLocationQueryParamObject.utm_source;
  } else if (eventData.pageLocationQueryParamObject.gclid) {
    source = "google";
  } else if (eventData.pageLocationQueryParamObject.dclid) {
    source = "dfa";
  } else if (eventData.pageLocationQueryParamObject.msclkid) {
    source = "bing";
  } else if (eventData.pageLocationQueryParamObject.awc) {
    source = "aw";
  } else if (eventData.page_referrer) {
    source = computeEffectiveTldPlusOne(eventData.page_referrer) || eventData.page_referrer;
  }

  log("Current source detected as " + source);

  return source;
}

function calculateNewMedium(eventData) {
  let medium;

  if (eventData.pageLocationQueryParamObject.utm_medium) {
    medium = eventData.pageLocationQueryParamObject.utm_medium;
  } else if (
    eventData.pageLocationQueryParamObject.gclid ||
    eventData.pageLocationQueryParamObject.msclkid
  ) {
    medium = "cpc";
  } else if (eventData.pageLocationQueryParamObject.dclid) {
    medium = "cpm";
  } else if (eventData.pageLocationQueryParamObject.awc) {
    medium = "referral";
  } else if (
    eventData.page_referrer &&
    eventData.page_referrer.match("google|bing|duckduckgo|yahoo")
  ) {
    medium = "organic";
  } else if (
    eventData.page_referrer &&
    eventData.page_referrer.match("facebook|instagram|pinterest")
  ) {
    medium = "social";
  } else if (eventData.page_referrer) {
    medium = "referral";
  }

  log("Current Medium detected as " + medium);
  return medium;
}

function storeAttribution(attribution, attributionKey) {
  const attributionStorageKey = getAttributionStorageKey(attributionKey);
  log("Attribution  will be stored under " + attributionStorageKey + " --> " + attribution);

  if (!attribution) {
    return;
  }

  setCookie(attributionStorageKey, attribution, {
    "max-age": 60 * makeInteger(data.attributionTimeoutInMinutes),
    httpOnly: true,
    domain: "auto",
  });
}

function getAttributionStorageKey(attributionKey) {
  if (attributionKey === "SOURCE") {
    return "BTNT_SOURCE";
  }

  if (attributionKey === "MEDIUM") {
    return "BTNT_MEDIUM";
  }
  return undefined;
}

function getAttributionCookie(attributionKey) {
  const attributionStorageKey = getAttributionStorageKey(attributionKey);

  const attributionCookieValue = getCookieValues(attributionStorageKey)[0];
  log("getAttributionCookie:" + attributionStorageKey + " = " + attributionCookieValue);

  if (!attributionCookieValue) {
    return undefined;
  }

  log("returnAttribution: " + attributionCookieValue);

  return attributionCookieValue;
}

/**
 *add a new server timing to the header
 *
 * @param {*} previous the previous server-timing header value
 * @param {*} task short description of task (e. g. pii, tags, or event)
 * @param {*} startTime timestamp in milliseconds at which this client started doing stuff
 * @returns server timing string. e. g. pii;dur=53, tags;dur=47.2
 */
function addToServerTiming(previous, task, startTime) {
  const duration = getTimestampMillis() - startTime;
  let newTiming;
  if (previous) {
    newTiming = previous + ", " + task + ";dur=" + duration;
  } else {
    newTiming = task + ";dur=" + duration;
  }

  return newTiming;
}

